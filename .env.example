# ---------------------------------------------------------------------------
# Run mode
#   mock       – no credentials needed; an in-process fake Banxa sends signed webhooks
#   sandbox    – real Banxa sandbox (api.banxa-sandbox.com)
#   production – real Banxa production (api.banxa.com)
# ---------------------------------------------------------------------------
BANXA_MODE=mock

# Public URL of this app. Used for redirectUrl on orders.
APP_URL=http://localhost:3000

# Partner API (v2) – used through BanxaApiClient from the SDK (x-api-key auth)
BANXA_PARTNER=
BANXA_API_KEY=

# Native API (v0) – identities, eligibility, PayID ramps (HMAC-signed)
BANXA_NATIVE_KEY=
BANXA_NATIVE_SECRET=

# Secret Banxa uses to sign webhooks. Defaults to BANXA_NATIVE_SECRET.
BANXA_WEBHOOK_SECRET=
# Path Banxa calls (configure the full URL in the Partner Dashboard).
BANXA_WEBHOOK_PATH=/api/webhooks/banxa

# Domain registered with Banxa for Apple Pay on the web (optional).
NEXT_PUBLIC_MERCHANT_DOMAIN=

# Signs session cookies (at least 32 characters). Required outside mock mode.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Reuse verifications from your own Sumsub account (KYC token sharing): none | sumsub
KYC_SHARING=none
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Enables POST /api/sync for scheduled reconciliation (send as "Authorization: Bearer <secret>").
SYNC_SECRET=

# SQLite database file.
DATABASE_PATH=./data/onramp.db

# Mock mode only: amounts (AUD) at or above these trigger extra checks (address is asked at A$1,000).
MOCK_EDD_THRESHOLD=200
MOCK_VERIFICATION_THRESHOLD=5000
